# ==============================================================================
# Chatbot Environment Variables Blueprint
# Copy this file to .env and fill in your actual values.
# Do NOT commit the .env file to your version control system.
# ==============================================================================

# Meta Webhook Verification Token
# This is a random string you generate. You will input this same token in the
# Meta Developer Portal when configuring your Webhook.
VERIFY_TOKEN=your_super_secret_verify_token_here

# Meta App Secret
# Found in Meta Developer Portal -> App Settings -> Basic.
# Used to verify the integrity and origin of incoming webhook payloads.
APP_SECRET=your_meta_app_secret_here

# WhatsApp Cloud API Configuration
# Found in Meta Developer Portal -> WhatsApp -> API Setup.
# PHONE_NUMBER_ID represents the sender phone number's ID.
# WHATSAPP_ACCESS_TOKEN is your system user access token or temporary access token.
PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Gemini Configuration
# Found in Google AI Studio.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_OUTPUT_TOKENS=500

# Welcome Logo Configuration
WELCOME_LOGO_URL=
WELCOME_LOGO_CAPTION=Timeless Elegance, Crafted For You ✨

# Database Configuration
DATABASE_URL=
